#!/usr/bin/env python3
"""
P3 — Production Database Initialization (One-Shot)

Creates production.db with approved schema matching backend/hos4c/database.py.
Idempotent — validates full schema on re-run. No simulation data.
Exits 0 if DB already initialized and valid, 2 on error.
"""
import os
import sys
import sqlite3


DB_PATH = os.environ.get("DATABASE_PATH", "/opt/hermes/data/production.db")
DATA_DIR = os.path.dirname(DB_PATH)
SCHEMA_VERSION = 1

EXPECTED_TABLES = {
    "decisions", "audit_events", "sessions",
    "idempotency_records", "schema_version",
}
EXPECTED_INDEXES = {
    "idx_audit_decision", "idx_audit_idempotency", "idx_audit_hash",
}


def verify_existing(conn):
    """Verify existing database has expected schema and integrity."""
    # Integrity
    integrity = conn.execute("PRAGMA integrity_check").fetchone()[0]
    if integrity != "ok":
        print(f"ERROR: integrity_check failed: {integrity}")
        return False

    # Tables
    actual = {r[0] for r in conn.execute(
        "SELECT name FROM sqlite_master WHERE type='table'")}
    if not EXPECTED_TABLES.issubset(actual):
        missing = EXPECTED_TABLES - actual
        print(f"ERROR: missing tables: {missing}")
        return False

    # Indexes
    idx_actual = {r[0] for r in conn.execute(
        "SELECT name FROM sqlite_master WHERE type='index'")}
    if not EXPECTED_INDEXES.issubset(idx_actual):
        missing = EXPECTED_INDEXES - idx_actual
        print(f"ERROR: missing indexes: {missing}")
        return False

    # Schema version
    row = conn.execute(
        "SELECT version FROM schema_version ORDER BY version DESC LIMIT 1"
    ).fetchone()
    if not row:
        print("ERROR: schema_version table has no rows")
        return False
    version = row[0]
    if version != SCHEMA_VERSION:
        print(f"ERROR: expected version {SCHEMA_VERSION}, got {version}")
        return False

    return True


def setup_ownership():
    """Set ownership for production container (UID 10010, GID 10010).
    Docker named volumes are initially root-owned. The production
    API runs as UID 10010 and needs read/write access to create
    WAL/SHM files and manage the database."""
    # Directory: 10010 needs to create -wal/-shm files
    os.chown(DATA_DIR, 10010, 10010)
    os.chmod(DATA_DIR, 0o750)

    # Database file
    os.chown(DB_PATH, 10010, 10010)
    os.chmod(DB_PATH, 0o640)

    # WAL/SHM if present (may not exist after clean checkpoint close)
    wal = DB_PATH + "-wal"
    shm = DB_PATH + "-shm"
    for f in (wal, shm):
        if os.path.exists(f):
            os.chown(f, 10010, 10010)
            os.chmod(f, 0o640)


def main():
    if os.path.exists(DB_PATH):
        try:
            conn = sqlite3.connect(DB_PATH)
            ok = verify_existing(conn)
            conn.close()
            if ok:
                print(f"Database already initialized at version {SCHEMA_VERSION}")
                sys.exit(0)
            else:
                sys.exit(2)
        except sqlite3.OperationalError as e:
            print(f"ERROR: {DB_PATH} exists but cannot be opened: {e}")
            sys.exit(2)

    # Create fresh database
    conn = sqlite3.connect(DB_PATH)
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("PRAGMA foreign_keys=ON")

    # Schema from backend/hos4c/database.py — exact match
    conn.executescript("""
        CREATE TABLE decisions (
            id TEXT PRIMARY KEY,
            title TEXT NOT NULL,
            state TEXT NOT NULL DEFAULT 'AWAITING_AMJAD',
            version INTEGER NOT NULL DEFAULT 1,
            owner TEXT NOT NULL DEFAULT 'amjad',
            project TEXT NOT NULL DEFAULT 'hermes-os',
            decision_text TEXT,
            reason TEXT,
            created_at TEXT NOT NULL,
            updated_at TEXT NOT NULL
        );

        CREATE TABLE audit_events (
            event_id TEXT PRIMARY KEY,
            event_type TEXT NOT NULL,
            decision_id TEXT NOT NULL,
            action TEXT NOT NULL,
            actor_id TEXT NOT NULL,
            actor_role TEXT NOT NULL,
            session_id TEXT,
            previous_state TEXT NOT NULL,
            resulting_state TEXT NOT NULL,
            rationale TEXT,
            reason_code TEXT,
            decision_version INTEGER NOT NULL,
            expected_version INTEGER NOT NULL,
            idempotency_key TEXT NOT NULL,
            request_timestamp TEXT NOT NULL,
            confirmation_timestamp TEXT,
            execution_timestamp TEXT NOT NULL,
            result TEXT NOT NULL,
            failure_reason TEXT,
            correlation_id TEXT,
            client_context TEXT,
            previous_event_hash TEXT NOT NULL,
            event_hash TEXT NOT NULL,
            created_at TEXT NOT NULL,
            FOREIGN KEY (decision_id) REFERENCES decisions(id)
        );

        CREATE INDEX idx_audit_decision ON audit_events(decision_id, created_at);
        CREATE INDEX idx_audit_idempotency ON audit_events(idempotency_key);
        CREATE UNIQUE INDEX idx_audit_hash ON audit_events(event_hash);

        CREATE TABLE sessions (
            session_id TEXT PRIMARY KEY,
            actor_id TEXT NOT NULL,
            actor_role TEXT NOT NULL DEFAULT 'AMJAD_OWNER',
            csrf_token TEXT NOT NULL,
            created_at TEXT NOT NULL,
            expires_at TEXT NOT NULL,
            last_activity TEXT NOT NULL,
            is_revoked INTEGER NOT NULL DEFAULT 0
        );

        CREATE TABLE idempotency_records (
            idempotency_key TEXT PRIMARY KEY,
            decision_id TEXT NOT NULL,
            action TEXT NOT NULL,
            result TEXT,
            created_at TEXT NOT NULL,
            expires_at TEXT NOT NULL
        );

        CREATE TABLE schema_version (
            version INTEGER PRIMARY KEY,
            applied_at TEXT NOT NULL
        );

        INSERT INTO schema_version (version, applied_at)
        VALUES (1, datetime('now'));
    """)

    # Checkpoint WAL to clean up sidecar files
    conn.execute("PRAGMA wal_checkpoint(TRUNCATE)")
    conn.commit()
    conn.close()

    setup_ownership()

    print(f"Database initialized at version {SCHEMA_VERSION}: {DB_PATH}")
    return 0


if __name__ == "__main__":
    sys.exit(main())