[Unit]
Description=HOS-AUTO-01 Privileged Broker (per-connection, socket-activated)
Requires=hermes-broker.socket

[Service]
Type=oneshot
ExecStart=/opt/hermes-auto/bin/broker.py
StandardInput=socket
StandardOutput=socket
StandardError=journal
User=root
Group=root
# NoNewPrivileges intentionally NOT set (broker must run Docker as root)
# The broker is the narrow privileged boundary; the bridge is unprivileged.
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
