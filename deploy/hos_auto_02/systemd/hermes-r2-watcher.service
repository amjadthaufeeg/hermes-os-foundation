[Unit]
Description=HOS-AUTO-02 R2 Task Watcher
After=network-online.target hermes-broker.socket
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=hermes-auto
Group=hermes-auto
WorkingDirectory=/opt/hermes-auto
Environment=PYTHONPATH=/opt/hermes-auto
Environment=R2_CONTROL_DIR=/var/lib/hermes-auto/hermes-control
Environment=R2_DEPLOY_KEY=/opt/hermes-auto/creds/deploy-key
Environment=PYTHONUNBUFFERED=1
# ProtectSystem=strict makes /tmp read-only in the service mount namespace.
# Pytest's default fd capture needs a writable tempfile directory, so point
# standard Python tempfile resolution at the already-writable HOS state area.
Environment=TMPDIR=/var/lib/hermes-auto
ExecStart=/opt/hermes-auto/venv/bin/python3 -u -m deploy.hos_auto_02.watcher
Restart=on-failure
RestartSec=30

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# PrivateTmp removed — bridge needs access to /tmp/hos-auto-01-src (git checkout).
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Write access: writable runtime state ONLY (not source code)
ReadOnlyPaths=/opt/hermes-auto /etc/ssh
ReadWritePaths=/var/lib/hermes-auto /opt/hermes-auto/evidence /opt/hermes-auto/logs
ReadWritePaths=/home/hermes-auto/.ssh

MemoryMax=128M
CPUQuota=50%
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-r2-watcher

# No Docker, no sudo, no root SSH
# hermes-auto has no docker group membership
# Bridge/broker provide the only privileged execution path

[Install]
WantedBy=multi-user.target
