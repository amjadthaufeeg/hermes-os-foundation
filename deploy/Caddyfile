# Caddy configuration for Hermes Mission Control — STAGING
# Replace YOUR_DOMAIN with actual staging domain.

YOUR_DOMAIN {
    # Reverse proxy to FastAPI on loopback
    reverse_proxy 127.0.0.1:8420

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

