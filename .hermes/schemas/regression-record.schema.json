{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://hermes-os.local/schemas/regression-record.schema.json","title":"Regression Record","type":"object","required":["regression_id","title","status","symptoms","root_cause","fix"],"properties":{"regression_id":{"type":"string","pattern":"^REG-\\d{3}$"},"title":{"type":"string","minLength":5},"status":{"enum":["active","guarded","retired"]},"symptoms":{"type":"string","minLength":10},"root_cause":{"type":"string","minLength":10},"fix":{"type":"string","minLength":10}}}